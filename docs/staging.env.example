# Zmienne STAGINGU. Skopiuj do .env.staging (plik poza gitem: .gitignore ma .env*),
# uzupełnij, sprawdź:  npm run staging:check-env -- .env.staging
# a potem zaimportuj w Netlify (Site configuration → Environment variables → Import from a .env file).
# Żadna wartość nie może pochodzić z produkcji — skrypt to sprawdza.

# Adres witryny stagingu w Netlify, https, bez ukośnika na końcu
NEXT_PUBLIC_APP_URL=

# Supabase → projekt STAGINGU → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe w trybie TESTOWYM (Developers → API keys; webhook: Developers → Webhooks)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic — najlepiej osobny klucz z limitem wydatków
ANTHROPIC_API_KEY=

# Sekret crona kolejki raportów:  openssl rand -hex 32
CRON_SECRET=
